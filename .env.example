# Supabase project settings — Settings > API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — SERVER-SIDE ONLY. Never prefix with NEXT_PUBLIC_,
# never import it into a Client Component, never log it. It bypasses
# Row Level Security, which is exactly why it's the only thing allowed
# to write feedback/scans on behalf of anonymous customers (see
# supabase/migrations/0001_init.sql for the reasoning).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Base URL of this app, used to build absolute QR/NFC links.
# e.g. https://feedback.yourdomain.com in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional (Stage 7+ hardening): Upstash Redis for rate limiting the
# public feedback + scan endpoints. Leave unset to run with an
# in-memory fallback limiter (fine for local dev, not for production
# with multiple server instances).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
